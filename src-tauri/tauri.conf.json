{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ubumonitor-analytics-app",
  "version": "0.1.0",
  "identifier": "es.ubu.ubumonitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "UBUMonitor Analylics",
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRjY4RDk5MDBBRDFGRDYKUldUV0g2MEFtWTMyY0l6dlRKemM0UUVINVQ4NHpUeFExRWRkR1YzZVdJMUJaaWR6ZDh6UnFpNWMK",
      "endpoints": [
        "https://github.com/UBUMonitor/ubumonitor-analytics-web/releases/latest/download/latest.json"
      ]
    }
  }
}