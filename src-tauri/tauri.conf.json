{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ubumonitor-analytics-app",
  "version": "0.1.1",
  "identifier": "es.ubu.ubumonitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "UBUMonitor Analylics",
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/jre/**/*": "jre/",
      "resources/app.jar": "app.jar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5REUxN0IwMzFGNTFFRkIKUldUN0h2VXhzQmZlMmN2eUxIVDRxREFPSGxiUERXR1N1dU94d0RmUWhkTFlncjhtTmFiM1h4RlUK",
      "endpoints": [
        "https://github.com/UBUMonitor/ubumonitor-analytics-web/releases/latest/download/latest.json"
      ]
    }
  }
}