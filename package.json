{
  "name": "ubumonitor-analytics-app",
  "private": true,
  "version": "0.1.18",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "generate": "orval",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "machine-translate": "inlang machine translate --project project.inlang",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.4.4",
    "@inlang/paraglide-js": "^2.29.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.3",
    "daisyui": "^5.7.50",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "orval": "^8.43.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@lucide/svelte": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "9.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "echarts": "^6.1.0",
    "ky": "^2.2.0",
    "tailwindcss": "^4.3.3"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
