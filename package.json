{
  "name": "ubumonitor-analytics-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "generate": "orval",
    "generate:watch": "orval --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "machine-translate": "inlang machine translate --project project.inlang",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.4",
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "^2.18.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.3",
    "daisyui": "^5.5.20",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "orval": "^8.14.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/svelte-table": "9.0.0-beta.16",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-log": "~2.9.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "echarts": "^6.1.0",
    "tailwindcss": "^4.3.0"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
